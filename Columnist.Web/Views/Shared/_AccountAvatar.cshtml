@inject Columnist.Auth.Security.CurrentUser.IUserContext UserContext
@inject Columnist.Auth.Security.Photos.IUserPhotoService UserPhotos
@* The signed-in user's avatar in the account menu: the photo, or the initials. *@
@{
    var initials = string.Concat((UserContext.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    var photoUrl = UserContext.UserId is int userId ? (await UserPhotos.GetUrlsAsync()).GetValueOrDefault(userId) : null;
}
<span class="kb-av">
    @if (photoUrl is not null)
    {
        <img class="kb-photo" src="@photoUrl" alt="" />
    }
    else
    {
        @initials
    }
</span>

@inject Columnist.Auth.Security.CurrentUser.IUserContext UserContext
@inject Columnist.Web.Application.Teams.CurrentTeams CurrentTeams
@* The account menu's header (_Layout). Also returned by the profile popup for its hx-select-oob. *@
@{
    // Current team for the subtitle, resolved the same way as the side panel (team cookie + the user's teams).
    var myTeams = await CurrentTeams.GetAsync();
    var myTeam = myTeams.IsSuccess ? myTeams.Data!.Teams.FirstOrDefault(t => t.IsCurrent) : null;
}
<div class="kb-um-head" id="kb-um-head">
    <partial name="_AccountAvatar" />
    <div class="kb-um-who">
        <div class="kb-um-name">@UserContext.FullName</div>
        @if (myTeam is not null)
        {
            <div class="kb-um-sub">@(myTeam.IsOwner ? "Super Admin" : "Member") · @myTeam.Name</div>
        }
    </div>
</div>

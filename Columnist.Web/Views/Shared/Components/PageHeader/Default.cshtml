@{
    var title = ViewData["PageTitle"] as string;
    var subtitle = ViewData["Subtitle"] as string;
    var backUrl = ViewData["BackUrl"] as string;
    var backLabel = ViewData["BackLabel"] as string;
}
<div class="kb-ph">
    @if (!string.IsNullOrEmpty(backUrl))
    {
        <a class="kb-ph-back" href="@backUrl" aria-label="@backLabel" title="@backLabel">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
        </a>
    }
    @if (!string.IsNullOrEmpty(title))
    {
        <div class="kb-ph-text">
            <h1 class="kb-ph-title">@title</h1>
            @if (!string.IsNullOrEmpty(subtitle))
            {
                <p class="kb-ph-subtitle">@subtitle</p>
            }
        </div>
    }
</div>

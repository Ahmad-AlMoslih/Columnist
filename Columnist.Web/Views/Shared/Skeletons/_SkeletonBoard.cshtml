@model bool
@* Loading skeleton: the board (the header, the search and Filter buttons, and 4 neutral columns of 3 cards). Used by the
   board template in _Skeletons (Model true: one column and card, repeated by skeleton.js) and by the board's first-load
   shell (Tasks/Shell, Model false: all rendered). *@
@{
    var columns = Model ? 1 : 4;
    var cards = Model ? 1 : 3;
}
<div class="kb-page-header">
    <div class="kb-skel-heading">
        <span class="kb-skel-block kb-skel-strong kb-skel-page-title"></span>
        <span class="kb-skel-block kb-skel-line kb-skel-subtitle"></span>
    </div>
</div>
<div class="kb-board-toolbar">
    <span class="kb-skel-block kb-skel-input kb-skel-search"></span>
    <span class="kb-skel-block kb-skel-strong kb-skel-filter"></span>
</div>
<div class="kb-board">
    @for (var i = 0; i < columns; i++)
    {
        <div class="kb-column kb-skel-column" data-skeleton-repeat="@(Model ? "4" : null)">
            <div class="kb-column-header">
                <span class="kb-skel-block kb-skel-on-column kb-skel-line kb-skel-w-45"></span>
                <span class="kb-skel-block kb-skel-on-column kb-skel-pill kb-skel-count"></span>
            </div>
            <div class="kb-column-body">
                @for (var c = 0; c < cards; c++)
                {
                    <partial name="Skeletons/_SkeletonBoardCard" model="Model ? 3 : 1" />
                }
            </div>
        </div>
    }
</div>

@* Loading skeleton: six log rows (avatar, two text lines, a short time line on the right). Used by the log templates in _Skeletons. *@
<div class="au-row" data-skeleton-repeat="6">
    <span class="kb-skel-block kb-skel-strong kb-skel-circle kb-skel-avatar"></span>
    <div class="au-body">
        <span class="kb-skel-block kb-skel-line" data-skeleton-cycle="kb-skel-w-80|kb-skel-w-65"></span>
        <span class="kb-skel-block kb-skel-line" data-skeleton-cycle="kb-skel-w-45|kb-skel-w-30|kb-skel-w-30"></span>
    </div>
    <span class="kb-skel-block kb-skel-line kb-skel-time"></span>
</div>

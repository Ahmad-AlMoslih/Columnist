@* Loading skeleton: two comment rows (avatar, name line, text line). Used by the task view while its comments load, and by the task popup skeleton (_Skeletons). *@
<ul class="kb-comment-list">
    <li class="kb-comment">
        <span class="kb-skel-block kb-skel-strong kb-skel-circle kb-skel-avatar"></span>
        <div class="kb-comment-content">
            <span class="kb-skel-block kb-skel-strong kb-skel-line kb-skel-w-30"></span>
            <span class="kb-skel-block kb-skel-line kb-skel-w-80"></span>
        </div>
    </li>
    <li class="kb-comment">
        <span class="kb-skel-block kb-skel-strong kb-skel-circle kb-skel-avatar"></span>
        <div class="kb-comment-content">
            <span class="kb-skel-block kb-skel-strong kb-skel-line kb-skel-w-25"></span>
            <span class="kb-skel-block kb-skel-line kb-skel-w-55"></span>
        </div>
    </li>
</ul>

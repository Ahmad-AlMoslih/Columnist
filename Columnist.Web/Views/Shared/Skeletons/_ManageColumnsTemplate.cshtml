@* Manage board, Columns tab (_Columns): the header, the tabs, the name and columns cards, the buttons and the danger zone. *@
<template data-skeleton-template="manage-columns">
    <div class="kb-skel lb-page">
        <partial name="Skeletons/_SkeletonPageHeader" model="true" />
        <nav class="bm-tabs">
            <span class="bm-tab"><span class="kb-skel-block kb-skel-text kb-skel-tab"></span></span>
            <span class="bm-tab"><span class="kb-skel-block kb-skel-text kb-skel-tab"></span></span>
        </nav>
        <div class="bs-form">
            <section class="lb-card">
                <h2 class="lb-h"><span class="kb-skel-block kb-skel-strong kb-skel-text kb-skel-name"></span></h2>
                <span class="kb-skel-block kb-skel-input kb-skel-h-44"></span>
            </section>
            <section class="lb-card">
                <h2 class="lb-h"><span class="kb-skel-block kb-skel-strong kb-skel-text kb-skel-name"></span></h2>
                <p class="ts-note"><span class="kb-skel-block kb-skel-text kb-skel-w-80"></span></p>
                <div class="bs-cols">
                    <div class="bs-col" data-skeleton-repeat="4">
                        <span class="kb-skel-block kb-skel-grip"></span>
                        <span class="kb-skel-block kb-skel-strong kb-skel-circle kb-skel-dot"></span>
                        <span class="kb-skel-block kb-skel-btn"></span>
                        <span class="kb-skel-block kb-skel-input kb-skel-h-38 kb-skel-grow"></span>
                        <span class="bs-count"><span class="kb-skel-block kb-skel-text kb-skel-w-70"></span></span>
                        <span class="kb-skel-block kb-skel-del"></span>
                    </div>
                </div>
                <div class="bs-add">
                    <span class="kb-skel-block kb-skel-input kb-skel-h-44 kb-skel-grow"></span>
                    <span class="kb-skel-block kb-skel-strong kb-skel-btn-lg"></span>
                </div>
            </section>
            <div class="bs-actions">
                <span class="kb-skel-block kb-skel-btn-lg"></span>
                <span class="kb-skel-block kb-skel-strong kb-skel-btn-lg"></span>
            </div>
        </div>
        <section class="lb-card">
            <h2 class="lb-h"><span class="kb-skel-block kb-skel-strong kb-skel-text kb-skel-name"></span></h2>
            <p class="ts-note"><span class="kb-skel-block kb-skel-text kb-skel-w-90"></span></p>
            <span class="kb-skel-block kb-skel-strong kb-skel-btn kb-skel-h-40"></span>
        </section>
    </div>
</template>

@model int
@* Loading skeleton: the logs filters (search, person select and Model category chips). Used by the board and team logs page templates in _Skeletons. *@
<div class="au-filters">
    <span class="kb-skel-block kb-skel-input au-search"></span>
    <span class="kb-skel-block kb-skel-filter"></span>
    <div class="au-chips">
        <span class="kb-skel-block kb-skel-tag" data-skeleton-repeat="@Model"></span>
    </div>
</div>

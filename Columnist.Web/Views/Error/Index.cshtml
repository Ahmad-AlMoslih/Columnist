@model ErrorPageModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="kb-form-card text-center mx-auto p-5" style="max-width: 560px;">
    <div class="display-1 fw-bold">@Model.StatusCode</div>
    <h1 class="kb-page-title">@Model.Title</h1>
    <p class="text-muted mb-4">@Model.Message</p>
</div>

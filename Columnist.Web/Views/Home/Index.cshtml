@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Columnist · Task boards for small teams</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body class="lp">

    <header class="lp-top">
        <div class="lp-brand">
            <img src="~/images/columnist-logo.png" alt="Columnist" class="lp-brand-logo" />
        </div>
        <nav class="lp-nav" aria-label="Main">
            <a class="lp-nav-link" href="#features">Features</a>
            <a class="lp-nav-link" href="#how">How it works</a>
            <a class="lp-btn lp-btn-sm" asp-area="Tasks" asp-controller="Tasks" asp-action="Index">Sign in</a>
        </nav>
    </header>

    <main>
        <section class="lp-hero">
            <div class="lp-hero-text">
                <span class="lp-eyebrow">Team task boards</span>
                <h1 class="lp-title">Every task has<br />a column.</h1>
                <p class="lp-lead">Plan work on boards, drag tasks from To Do to Done, attach screenshots, and always know who changed what.</p>
                <div class="lp-actions">
                    <a class="lp-btn lp-btn-lg" asp-area="Tasks" asp-controller="Tasks" asp-action="Index">
                        Sign in
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                    </a>
                    <a class="lp-btn-outline" href="#how">See how it works</a>
                </div>
            </div>

            <div class="lp-board" aria-hidden="true">
                <div class="lp-col">
                    <span class="lp-pill lp-pill-todo">To Do</span>
                    <div class="lp-card">Redesign pricing page<div class="lp-thumb lp-thumb-a"></div></div>
                    <div class="lp-card">Onboarding screens</div>
                </div>
                <div class="lp-col lp-col-from">
                    <span class="lp-pill lp-pill-progress">In Progress</span>
                    <div class="lp-slot">
                        <div class="lp-card lp-card-moving">Login with biometrics<div class="lp-card-note">Dragging…</div></div>
                    </div>
                </div>
                <div class="lp-col">
                    <span class="lp-pill lp-pill-done">Done</span>
                    <div class="lp-landing-slot"></div>
                    <div class="lp-card">Splash screen</div>
                    <div class="lp-card">404 error page<div class="lp-thumb lp-thumb-b"></div></div>
                </div>
            </div>
        </section>

        <section id="features" class="lp-features">
            <div class="lp-wrap">
                <div class="lp-section-head">
                    <h2 class="lp-h2">Everything a small team needs</h2>
                    <p class="lp-muted">No setup, no clutter. Just boards that stay fast and honest.</p>
                </div>
                <div class="lp-grid">
                    <article class="lp-feature">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="5" height="18" rx="1.5"></rect><rect x="10" y="3" width="5" height="12" rx="1.5"></rect><rect x="17" y="3" width="4" height="8" rx="1.5"></rect></svg>
                        <h3>Boards and columns</h3>
                        <p>One board per project, with clear To Do, In Progress and Done columns.</p>
                    </article>
                    <article class="lp-feature">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9l-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3M2 12h20M12 2v20"></path></svg>
                        <h3>Drag and drop</h3>
                        <p>Move a task to the next column by dragging it. It saves instantly.</p>
                    </article>
                    <article class="lp-feature">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
                        <h3>Images on every task</h3>
                        <p>Attach screenshots and mockups, and open them full size with one click.</p>
                    </article>
                    <article class="lp-feature">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
                        <h3>Live search</h3>
                        <p>Type two letters and the board filters as you go, no reload.</p>
                    </article>
                    <article class="lp-feature">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"></path></svg>
                        <h3>Roles and secure sign-in</h3>
                        <p>Admins and team members each see what they should, nothing more.</p>
                    </article>
                    <article class="lp-feature">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5M12 7v5l3 2"></path></svg>
                        <h3>History and restore</h3>
                        <p>See who created, changed or deleted a task. Deleted tasks can be restored.</p>
                    </article>
                </div>
            </div>
        </section>

        <section id="how" class="lp-wrap lp-how">
            <h2 class="lp-h2">How it works</h2>
            <ol class="lp-steps">
                <li class="lp-step">
                    <span class="lp-step-num" aria-hidden="true">1</span>
                    <h3>Sign in</h3>
                    <p>Use the account your admin gave you.</p>
                </li>
                <li class="lp-step">
                    <span class="lp-step-num" aria-hidden="true">2</span>
                    <h3>Add your tasks</h3>
                    <p>Give each one a title, an owner, a due date and images.</p>
                </li>
                <li class="lp-step">
                    <span class="lp-step-num" aria-hidden="true">3</span>
                    <h3>Drag them to Done</h3>
                    <p>Move cards as work progresses. The whole team sees it.</p>
                </li>
            </ol>
            <div class="lp-cta">
                <div>
                    <p class="lp-cta-title">Ready to see your board?</p>
                    <p class="lp-cta-text">Sign in and pick up where you left off.</p>
                </div>
                <a class="lp-btn lp-btn-md" asp-area="Tasks" asp-controller="Tasks" asp-action="Index">Sign in</a>
            </div>
        </section>
    </main>

    <footer class="lp-footer">© @DateTime.Now.Year Columnist</footer>
</body>
</html>

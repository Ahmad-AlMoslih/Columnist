@{
    ViewData["Title"] = "Link expired";
    Layout = "_AuthLayout";
}
<div class="login-heading">
    <h1 class="login-title">This link has expired</h1>
    <p class="login-subtitle">Reset links work once and expire after 30 minutes. Ask for a new one to set your password.</p>
</div>

<div class="login-actions">
    <a asp-area="Auth" asp-controller="Account" asp-action="ForgotPassword" class="login-submit">Send a new link</a>
    <a asp-area="Auth" asp-controller="Account" asp-action="Login" class="login-secondary">Back to sign in</a>
</div>

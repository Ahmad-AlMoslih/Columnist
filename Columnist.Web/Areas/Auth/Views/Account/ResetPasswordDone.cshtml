@{
    ViewData["Title"] = "Password changed";
    Layout = "_AuthLayout";
}
<div class="login-heading">
    <h1 class="login-title">Password changed</h1>
    <p class="login-subtitle">You've been signed out everywhere.</p>
</div>

<a asp-area="Auth" asp-controller="Account" asp-action="Login" class="login-submit">
    Sign in
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
</a>

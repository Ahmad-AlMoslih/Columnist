@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}
<div class="login-heading">
    <h1 class="login-title">Check your email</h1>
    <p class="login-subtitle">If that email exists, we've sent a reset link to it. The link works once and expires in 30 minutes.</p>
</div>

<a asp-area="Auth" asp-controller="Account" asp-action="Login" class="login-secondary">Back to sign in</a>

@model Columnist.Contracts.Dtos.ResetPasswordFormDto
@{
    ViewData["Title"] = "Set a new password";
    Layout = "_AuthLayout";
}
<form asp-area="Auth" asp-controller="Account" asp-action="ResetPassword" method="post" class="login-form">
    <input type="hidden" asp-for="Token" />

    <div class="login-heading">
        <h1 class="login-title">Set a new password</h1>
        <p class="login-subtitle">For <strong>@Model.Email</strong></p>
    </div>

    <div class="login-field">
        <label asp-for="NewPassword" class="login-label">New password</label>
        <input asp-for="NewPassword" type="password" class="login-input" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="login-error"></span>
    </div>

    <div class="login-field">
        <label asp-for="ConfirmPassword" class="login-label">Confirm new password</label>
        <input asp-for="ConfirmPassword" type="password" class="login-input" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="login-error"></span>
        <div asp-validation-summary="ModelOnly" class="login-error"></div>
    </div>

    <button type="submit" class="login-submit">Save new password</button>
</form>

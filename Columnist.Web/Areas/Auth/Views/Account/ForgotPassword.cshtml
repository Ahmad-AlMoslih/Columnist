@model Columnist.Contracts.Dtos.ForgotPasswordFormDto
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}
<form asp-area="Auth" asp-controller="Account" asp-action="ForgotPassword" method="post" class="login-form">
    <div class="login-heading">
        <h1 class="login-title">Forgot your password?</h1>
        <p class="login-subtitle">Enter your email and we'll send you a link to set a new one.</p>
    </div>

    <div class="login-field">
        <label asp-for="Email" class="login-label">Email</label>
        <input asp-for="Email" type="email" class="login-input" autocomplete="email" placeholder="e.g. ahmed@example.com" />
        <span asp-validation-for="Email" class="login-error"></span>
        <div asp-validation-summary="ModelOnly" class="login-error"></div>
    </div>

    <div class="login-actions">
        <button type="submit" class="login-submit">Send reset link</button>
        <a asp-area="Auth" asp-controller="Account" asp-action="Login" class="login-secondary">Back to sign in</a>
    </div>
</form>

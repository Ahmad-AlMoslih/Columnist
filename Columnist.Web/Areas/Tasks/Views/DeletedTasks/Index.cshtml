@model Columnist.Tasks.Features.Tasks.Queries.GetDeletedTasks.Models.GetDeletedTasksModel
@{
    ViewData["Title"] = "Deleted tasks";
}

<div id="kb-toasts">
    @if (TempData["Message"] is not null || TempData["Error"] is not null)
    {
        <div class="kb-toast-stack">
            @if (TempData["Message"] is string success)
            {
                <div class="kb-toast kb-toast-success" role="status" aria-live="polite">
                    <span class="kb-toast-text">@success</span>
                    <button type="button" class="kb-toast-close" aria-label="Close">&times;</button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="kb-toast kb-toast-error" role="alert">
                    <span class="kb-toast-text">@error</span>
                    <button type="button" class="kb-toast-close" aria-label="Close">&times;</button>
                </div>
            }
        </div>
    }
</div>

<section id="kb-deleted-region" class="kb-deleted">
    <div class="kb-deleted-head">
        <h1 class="kb-deleted-title">Deleted tasks</h1>
        <span class="kb-deleted-count">@Model.Tasks.Count</span>
    </div>

    @await Component.InvokeAsync("SearchBox", new
    {
        url = Url.Action("Index", "DeletedTasks", new { area = "Tasks" }),
        target = "#kb-deleted-results",
        value = Model.Search,
        placeholder = "Search deleted tasks by title…"
    })

    <div id="kb-deleted-results">
    @if (Model.Tasks.Count == 0)
    {
        <p class="kb-deleted-empty">No deleted tasks.</p>
    }
    else
    {
        <div class="kb-deleted-grid">
            @foreach (var task in Model.Tasks)
            {
                <article class="kb-deleted-card">
                    <div class="kb-deleted-card-top">
                        <span class="kb-deleted-pill">Deleted</span>
                        <span class="kb-deleted-where">@task.BoardName › @task.ColumnName</span>
                    </div>

                    <h2 class="kb-deleted-card-title">@task.Title</h2>

                    @if (task.ImageUrls.Count > 0)
                    {
                        <div class="kb-gallery">
                            @foreach (var url in task.ImageUrls)
                            {
                                <img src="@url" alt="Image of @task.Title" loading="lazy" />
                            }
                        </div>
                    }

                    <p class="kb-deleted-by">
                        Deleted by @(task.DeletedByName ?? "unknown") · @task.DeletedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                    </p>

                    <form asp-area="Tasks" asp-controller="DeletedTasks" asp-action="Restore" method="post" class="kb-restore-form" data-task-title="@task.Title"
                          hx-post="@Url.Action("Restore", "DeletedTasks", new { area = "Tasks" })" hx-target="#kb-deleted-region" hx-select="#kb-deleted-region" hx-select-oob="#kb-toasts" hx-swap="outerHTML" hx-confirm="Restore task?">
                        <input type="hidden" name="token" value="@task.Token" />
                        <button type="submit" class="kb-restore">Restore</button>
                    </form>
                </article>
            }
        </div>
    }
    </div>
</section>

<div class="modal fade" id="kb-restore-modal" tabindex="-1" aria-labelledby="kb-restore-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content kb-modal">
            <div class="kb-modal-body">
                <div class="kb-modal-icon kb-modal-icon-restore">
                    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5" />
                    </svg>
                </div>
                <h2 class="kb-modal-title" id="kb-restore-title">Restore task?</h2>
                <p class="kb-modal-text">
                    <strong id="kb-restore-name"></strong> will be moved back to its board.
                </p>
            </div>
            <div class="kb-modal-footer">
                <button type="button" class="kb-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="kb-btn-primary" id="kb-restore-confirm">Restore task</button>
            </div>
        </div>
    </div>
</div>

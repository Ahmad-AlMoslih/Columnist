@model string
@* A Dashboard / Report card's icon by its key (_ReportCard, _DashboardCard and the Dashboard's "View all" popup). *@
<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "overdue":
            <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5"></path><path d="M12 16h.01"></path>
            break;
        case "week":
            <rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path>
            break;
        case "mine":
            <circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path>
            break;
        case "unassigned":
            <circle cx="10" cy="8" r="4"></circle><path d="M2 21a8 8 0 0 1 13.3-6"></path><path d="M19 15v6M16 18h6"></path>
            break;
        case "checklists":
            <path d="M9 11l3 3 8-8"></path><path d="M20 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            break;
        case "completed":
            <circle cx="12" cy="12" r="9"></circle><path d="M8 12l3 3 5-6"></path>
            break;
        case "created":
            <rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M12 8v8M8 12h8"></path>
            break;
        case "activity":
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            break;
        case "late":
            <circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2"></path><path d="M5 3L2 6M22 6l-3-3"></path>
            break;
        case "stale":
            <path d="M6 2h12M6 22h12"></path><path d="M6 2c0 5 6 6 6 10s-6 5-6 10M18 2c0 5-6 6-6 10s6 5 6 10"></path>
            break;
        case "nodue":
            <rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path><path d="M10 14l4 4M14 14l-4 4"></path>
            break;
        case "column-done":
            <rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 12l3 3 5-6"></path>
            break;
        default:
            <rect x="3" y="3" width="7" height="18" rx="1.5"></rect><rect x="14" y="3" width="7" height="12" rx="1.5"></rect>
            break;
    }
</svg>

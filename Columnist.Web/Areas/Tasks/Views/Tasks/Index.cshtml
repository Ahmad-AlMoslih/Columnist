@model Columnist.Tasks.Features.Tasks.Queries.GetBoard.Models.GetBoardModel
@using System.Globalization
@using Columnist.Tasks.Features.Tasks.Queries.GetBoard.Models
@using Microsoft.AspNetCore.WebUtilities
@{
    var canWrite = Model.CanWrite;
    ViewData["Crumb"] = Model.SelectedBoardName;
    var canManage = Model.CanManage;
    var boardMenu = Model.SelectedBoardToken is null ? null : new Columnist.Web.Models.BoardUserMenuViewModel(Model.SelectedBoardToken, Model.CanSeeDeleted, Model.CanSeeLogs, canManage);
    //^^ the stuff in the side panel
    var boardUrl = Url.Action("Index", "Tasks", new { area = "Tasks" })!;//checks which boards you have access too

    // The "Due" chip: "This week", "3 Nov – 10 Nov", "from 3 Nov", "until 10 Nov".
    var filter = Model.Filter;
    string Day(DateOnly date) => date.ToString("d MMM", CultureInfo.InvariantCulture);
    var dueText = filter.Due switch
    {
        null => null,
        BoardFilterModel.DueCustom when filter.From is not null && filter.To is not null => $"{Day(filter.From.Value)} – {Day(filter.To.Value)}",
        BoardFilterModel.DueCustom when filter.From is not null => $"from {Day(filter.From.Value)}",
        BoardFilterModel.DueCustom => $"until {Day(filter.To!.Value)}",
        _ => BoardFilterModel.DueOptions.First(o => o.Key == filter.Due).Value
    };
}

@section TopBar {
    @if (canWrite && Model.SelectedBoardToken is not null)
    {
        <a class="kb-btn-primary" asp-area="Tasks" asp-controller="Tasks" asp-action="New" asp-route-boardToken="@Model.SelectedBoardToken"
           hx-get="@Url.Action("New", "Tasks", new { area = "Tasks", boardToken = Model.SelectedBoardToken })" hx-target="#kb-task-modal-body" hx-swap="innerHTML"
           data-skeleton="task-view" data-skeleton-label="Loading task">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            New task
        </a>
    }
}

@if (boardMenu?.Any == true)
{
    @section UserMenu {
        <partial name="_BoardUserMenu" model="boardMenu" />
    }
}

@* Board · Dashboard · Report (page-tabs.js): outside #kb-tab-page, so switching leaves it in place (a tab gets
   only #kb-tab-page, _TabLayout). *@
@if (!Context.Request.IsTabSwap())
{
    <div id="kb-page-tabs" class="kb-page-tabs" hidden="@(!(Model.SelectedBoardToken is not null && (Model.CanSeeReports || canManage)))">
        @if ((Model.SelectedBoardToken is not null && (Model.CanSeeReports || canManage)))
        {
            <partial name="_BoardPageTabs" model='new Columnist.Web.Models.BoardPageTabsViewModel(Model.SelectedBoardToken!, Columnist.Web.Models.BoardPageTabsViewModel.Board)' />
        }
    </div>
}

@if (Model.Boards.Count == 0)
{
    <div id="kb-tab-page" data-page="board">
        <partial name="_TaskToasts" />
        <div class="kb-empty-state">
            <h2>No boards yet</h2>
            <p class="mb-0">Once a board is created, its columns and tasks will show up here.</p>
        </div>
    </div>
    return;
}

<div id="kb-tab-page" data-page="board">
<div id="kb-toasts">
    @if (TempData["Message"] is not null || TempData["Error"] is not null)
    {
        <div class="kb-toast-stack">
            @if (TempData["Message"] is string success)
            {
                <div class="kb-toast kb-toast-success" data-toast-type="success" role="status" aria-live="polite">
                    <span class="kb-toast-text">@success</span>
                    <button type="button" class="kb-toast-close" aria-label="Close">&times;</button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="kb-toast kb-toast-error" data-toast-type="error" role="alert">
                    <span class="kb-toast-text">@error</span>
                    <button type="button" class="kb-toast-close" aria-label="Close">&times;</button>
                </div>
            }
        </div>
    }
</div>

<div id="kb-board-region" hx-ext="morph" data-board-token="@Model.SelectedBoardToken">
    <div class="kb-page-header">
        <div>
            <h1 class="kb-page-title">@Model.SelectedBoardName</h1>
            <p class="kb-subtitle" id="kb-board-subtitle">
                @if (Model.IsFiltered)
                {
                    @($"{Model.TaskCount} of {Model.TotalTaskCount} tasks across {Model.Columns.Count} columns")
                }
                else
                {
                    @($"{Model.TaskCount} tasks across {Model.Columns.Count} columns")
                }
            </p>
        </div>
        <nav class="kb-tabs" aria-label="Boards">
            @foreach (var tab in Model.Boards)
            {
                var active = tab.Selected;
                <a class="kb-tab @(active ? "active" : null)" aria-current="@(active ? "page" : null)"
                   asp-action="Index" asp-route-boardToken="@tab.Token"
                   hx-get="@Url.Action("Index", new { boardToken = tab.Token })" hx-target="#kb-board-region" hx-select="#kb-board-region" hx-select-oob="#kb-toasts,#kb-page-tabs" hx-swap="outerHTML" hx-push-url="true"
                   data-skeleton="board" data-skeleton-label="Loading board">@tab.Name</a>
            }
        </nav>
    </div>

    @* The search and the filter each reload the columns with both their values; the two rows below come along (hx-select-oob) and the URL is pushed. *@
    <div class="kb-board-toolbar" hx-select-oob="#kb-active-filters,#kb-board-subtitle,#kb-toasts" hx-push-url="true">
        @await Component.InvokeAsync("SearchBox", new
        {
            url = boardUrl,
            target = "#kb-board-columns",
            value = Model.Search,
            placeholder = "Search tasks by title…",
            hiddenFields = new Dictionary<string, string?> { ["boardToken"] = Model.SelectedBoardToken },
            include = "#kb-board-filter-form"
        })
        @await Component.InvokeAsync("BoardFilter", new { filter = Model.Filter, url = boardUrl, searchForm = ".kb-board-toolbar form.kb-search" })
    </div>

    @* Removing a chip clears that value in the filter panel (or the search box) and reloads (board-filter.js). *@
    <div id="kb-active-filters" class="kb-active-filters" hidden="@(!Model.IsFiltered)">
        @if (Model.IsFiltered)
        {
            <span class="kb-active-filters-count">Showing @Model.TaskCount of @Model.TotalTaskCount tasks</span>
            @if (Model.IsSearchActive)
            {
                <button type="button" class="kb-filter-chip" data-filter-remove="search">Search: "@(Model.Search!.Trim())"<span aria-hidden="true">×</span></button>
            }
            @if (Model.Filter.MeSelected)
            {
                <button type="button" class="kb-filter-chip" data-filter-remove="assignees" data-filter-value="@Model.Filter.MeToken">Assignee: Me<span aria-hidden="true">×</span></button>
            }
            @foreach (var member in Model.Filter.Members.Where(m => m.Selected))
            {
                <button type="button" class="kb-filter-chip" data-filter-remove="assignees" data-filter-value="@member.Token">Assignee: @member.Name<span aria-hidden="true">×</span></button>
            }
            @if (Model.Filter.Unassigned)
            {
                <button type="button" class="kb-filter-chip" data-filter-remove="unassigned">Assignee: Unassigned<span aria-hidden="true">×</span></button>
            }
            @if (dueText is not null)
            {
                <button type="button" class="kb-filter-chip" data-filter-remove="due">Due: @dueText<span aria-hidden="true">×</span></button>
            }
            @foreach (var status in BoardFilterModel.StatusOptions.Where(o => Model.Filter.Statuses.Contains(o.Key)))
            {
                <button type="button" class="kb-filter-chip" data-filter-remove="status" data-filter-value="@status.Key">Status: @status.Value<span aria-hidden="true">×</span></button>
            }
            @if (Model.Filter.Unfinished)
            {
                <button type="button" class="kb-filter-chip" data-filter-remove="unfinished">Unfinished checklist<span aria-hidden="true">×</span></button>
            }
            <button type="button" class="kb-filter-clear" data-filter-clear>Clear all</button>
        }
    </div>

    @* data-refresh-url: live-board.js reloads the board with the shown search and filter. Dragging is off while they are on. *@
    <div id="kb-board-columns" class="kb-board" data-board-pan data-refresh-url="@QueryHelpers.AddQueryString(Url.Action("Index", new { boardToken = Model.SelectedBoardToken })!, Model.ToQuery())">
        @foreach (var column in Model.Columns)
        {
            @* The status colours: the column background and the header band (none = the neutral look). *@
            <section class="kb-column" aria-label="@column.Name"
                     style="@(column.ColumnColor is null ? null : $"--kb-column-color:{column.ColumnColor};--kb-column-header-color:{column.HeaderColor}")">
                <div class="kb-column-header @column.HeaderClass">
                    <span class="kb-column-name">@column.Name</span>
                    <span class="kb-column-count">@(Model.IsFiltered ? $"{column.Tasks.Count} of {column.TotalTaskCount}" : column.Tasks.Count.ToString())</span>
                </div>

                <div class="kb-column-body" data-column-token="@column.ColumnToken" data-column-done="@(column.IsDone ? "true" : null)" data-can-move="@(canWrite && !Model.IsFiltered ? "true" : "false")">
                    @foreach (var task in column.Tasks)
                    {
                        <partial name="_TaskCard" model="task" view-data='new ViewDataDictionary(ViewData) { ["BoardToken"] = Model.SelectedBoardToken }' />
                    }

                    @if (column.Tasks.Count == 0)
                    {
                        <div class="kb-empty" data-column-empty>@(Model.IsFiltered ? "No matching tasks" : "No tasks")</div>
                    }
                </div>

                @if (canWrite)
                {
                    <a class="kb-add-task" asp-action="New" asp-route-columnToken="@column.ColumnToken" asp-route-boardToken="@Model.SelectedBoardToken"
                       hx-get="@Url.Action("New", new { columnToken = column.ColumnToken, boardToken = Model.SelectedBoardToken })" hx-target="#kb-task-modal-body" hx-swap="innerHTML"
                       data-skeleton="task-view" data-skeleton-label="Loading task">
                        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                        Add task
                    </a>
                }
            </section>
        }

        @if (canManage)
        {
            <button type="button" class="kb-add-column" data-add-column-open>
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                Add another column
            </button>
        }
    </div>

    @* The drag-and-drop move (board-dnd.js): the task, column and position are sent as values; the moves go one at a time, in order.
       data-card-url = the card re-render after a drag into or out of a Done column. *@
    <form id="kb-move-form" asp-action="Move" method="post" hidden hx-sync="this:queue all"
          data-card-url="@Url.Action("Card", new { boardToken = Model.SelectedBoardToken })"></form>
</div>

<partial name="_TaskModals" />

@* The statuses load when the popup first opens (add-column.js, data-statuses-url). *@
@if (canManage)
{
    <div class="modal fade" id="kb-add-column-modal" tabindex="-1" aria-labelledby="kb-add-column-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content kb-modal">
                <form class="kb-modal-body kb-add-column-form" data-add-column-form method="post"
                      asp-area="Teams" asp-controller="Boards" asp-action="AddColumn"
                      hx-post="@Url.Action("AddColumn", "Boards", new { area = "Teams" })" hx-target="#kb-board-region" hx-select="#kb-board-region" hx-select-oob="#kb-toasts" hx-swap="outerHTML">
                    <h2 class="kb-modal-title" id="kb-add-column-title">Add a column</h2>
                    <input type="hidden" name="boardToken" value="@Model.SelectedBoardToken" data-add-column-board />
                    <div class="mb-3">
                        <label class="form-label" for="kb-add-column-name">Column name</label>
                        <input id="kb-add-column-name" name="name" class="form-control" maxlength="@Columnist.Teams.Features.Boards.Commands.SaveBoard.SaveBoardCommand.ColumnNameMaxLength" required autocomplete="off" data-add-column-name />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="kb-add-column-status">Status</label>
                        <div class="kb-add-column-status">
                            <span class="bs-dot" data-column-dot></span>
                            <select id="kb-add-column-status" name="statusName" class="form-select" data-add-column-status
                                    data-statuses-url="@Url.Action("ColumnStatuses", "Boards", new { area = "Teams" })"></select>
                        </div>
                    </div>
                    <div class="text-danger kb-add-column-error" role="alert"><span id="kb-add-column-error"></span></div>
                    <div class="kb-modal-footer">
                        <button type="button" class="kb-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="kb-btn-primary">Add column</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
</div>

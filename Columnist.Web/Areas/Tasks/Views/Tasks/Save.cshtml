@model Columnist.Contracts.Dtos.TaskFormDto

@await Component.InvokeAsync("PageHeader", new
{
    title = Model.IsNew ? "New task" : "Edit task",
    subtitle = (string?)null,
    backUrl = Url.Action("Index", new { boardToken = Model.ReturnBoardToken }),
    backLabel = "Back to board"
})

<partial name="_TaskForm" model="Model" />

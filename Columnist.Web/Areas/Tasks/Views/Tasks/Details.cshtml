@model Columnist.Tasks.Features.Tasks.Queries.GetTaskView.Models.GetTaskViewModel
@{
    ViewData["Title"] = Model.Title;
}

@* The task's title is shown by _TaskView (shared with the popup), so the header only adds the back button. *@
@await Component.InvokeAsync("PageHeader", new
{
    title = (string?)null,
    subtitle = (string?)null,
    backUrl = Url.Action("Index", new { boardToken = ViewData["BoardToken"] as string }),
    backLabel = "Back to board"
})
@* Target of the checklists region's hx-select-oob toasts. *@
<div id="kb-toasts"></div>
<div class="kb-view-page" data-board-token="@(ViewData["BoardToken"] as string)">
    <partial name="_TaskView" model="Model" />
</div>

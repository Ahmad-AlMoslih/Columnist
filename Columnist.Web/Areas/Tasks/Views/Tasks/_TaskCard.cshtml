@model Columnist.Tasks.Features.Tasks.Queries.GetBoard.Models.GetBoardTaskModel
@{
    var boardToken = ViewData["BoardToken"] as string;
    var canWrite = Model.CanWrite;
    var canDelete = Model.CanDelete;
    var isDone = Model.StatusName.Equals("Done", StringComparison.OrdinalIgnoreCase);// task status
    var noAccessNames = Model.Assignees.Where(a => !a.HasAccess).Select(a => a.FullName).ToList();//task assignees who no longer have access
}

@* ViewData["CardOob"] = true: marked hx-swap-oob, sent along with a task-view save to update this card on the board. *@
<article id="kb-card-@Model.Key" class="kb-card" data-task-token="@(canWrite? Model.Token: null)" data-card-token="@Model.Token"
         hx-swap-oob="@(ViewData["CardOob"] is true ? "true" : null)">
    @if (Model.FirstImageUrl is not null)
    {
        <div class="kb-cover">
            <img data-lightbox src="@Model.FirstImageUrl" alt="" loading="lazy" />
        </div>
    }

    <div class="kb-card-body">
        <div class="kb-card-title-row">
            <h3 class="kb-card-title">
                <a asp-action="Details" asp-route-token="@Model.Token" asp-route-boardToken="@boardToken" data-card-link
                   hx-get="@Url.Action("Details", new { token = Model.Token, boardToken })" hx-target="#kb-task-modal-body" hx-swap="innerHTML" data-skeleton="task-view" data-skeleton-label="Loading task">@Model.Title</a>
            </h3>
            @if (canDelete)
            {
                <form class="kb-card-delete" asp-action="Delete" method="post" data-confirm-title="Delete task?" data-confirm-yes="Delete"
                      data-confirm-text="@($"\"{Model.Title}\" moves to Deleted tasks. It can be restored.")"
                      hx-post="@Url.Action("Delete")" hx-target="#kb-toasts" hx-select="#kb-toasts" hx-swap="outerHTML">
                    <input type="hidden" name="token" value="@Model.Token" />
                    <button type="submit" class="kb-delete-btn" aria-label="Delete task" title="Delete task">
                        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
                    </button>
                </form>
            }
        </div>

        <div class="kb-card-badges">
            <span class="kb-card-badge" data-comment-badge title="@Model.CommentCount @(Model.CommentCount == 1 ? "comment" : "comments")" hidden="@(Model.CommentCount == 0)">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                <span data-comment-number>@Model.CommentCount</span>
            </span>
            @if (Model.ImageCount > 0)
            {
                <span class="kb-card-badge" title="@Model.ImageCount @(Model.ImageCount == 1 ? "image" : "images")">
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
                    <span>@Model.ImageCount</span>
                </span>
            }
            @if (Model.ChecklistTotal > 0)
            {
                <span class="kb-card-badge kb-card-checklist @(Model.ChecklistDone == Model.ChecklistTotal ? "kb-card-checklist-done" : null)" title="@Model.ChecklistDone of @Model.ChecklistTotal checklist items done">
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 12l3 3 5-6"></path></svg>
                    <span>@Model.ChecklistDone/@Model.ChecklistTotal</span>
                </span>
            }
            @Html.DueDateChip(Model.DueDate, isDone, forCard: true)
            @if (noAccessNames.Count > 0 && !isDone)
            {
                <span class="kb-noaccess-tag" title="@string.Join(", ", noAccessNames) can't see this board">No access</span>
            }
            @if (Model.Assignees.Count > 0)
            {
                <span class="kb-card-avatars" title="@string.Join(", ", Model.Assignees.Select(a => a.FullName))">
                    @foreach (var assignee in Model.Assignees.Take(3))
                    {
                        @Html.AvatarCircle(assignee.FullName, assignee.Initials, noAccess: !assignee.HasAccess && !isDone, photoUrl: assignee.PhotoUrl)
                    }
                    @if (Model.Assignees.Count > 3)
                    {
                        <span class="kb-avatar kb-avatar-more">+@(Model.Assignees.Count - 3)</span>
                    }
                </span>
            }
        </div>
    </div>
</article>

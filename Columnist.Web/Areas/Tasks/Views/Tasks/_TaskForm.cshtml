@model Columnist.Contracts.Dtos.TaskFormDto
@using Columnist.Contracts.Dtos
@using Columnist.Web.Application.Extensions

@{
    var today = DateTime.Today;
    var minDate = Model.DueDate is { } due && due.Date < today ? due.Date : today;
    var imageUrls = Model.ImageUrls ?? [];
    var inModal = Context.Request.IsHtmx();
    var selectedUsers = Model.Users.Where(u => u.Selected).ToList();
}

<div id="kb-task-form-root" class="kb-task-form">
    @if (inModal)
    {
        <div class="kb-task-form-head">
            <h2 class="kb-task-form-title" id="kb-task-modal-title">@(Model.IsNew ? "New task" : "Edit task")</h2>
            <button type="button" class="kb-view-close" data-bs-dismiss="modal" aria-label="Close"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
        </div>
    }
    <form asp-action="Save" method="post" enctype="multipart/form-data" class="kb-form-card"
          hx-post="@(inModal ? Url.Action("Save") : null)" hx-encoding="multipart/form-data"
          hx-target="#kb-board-region" hx-select="#kb-board-region" hx-select-oob="#kb-toasts" hx-swap="outerHTML">
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="ReturnBoardToken" />
        <input type="hidden" asp-for="RowVersion" />

        <div class="kb-form-body">
            <div asp-validation-summary="ModelOnly" class="text-danger kb-form-summary"></div>

            <div class="kb-form-main">
                @Html.TextFieldFor(m => m.Title,
                requiredMessage: ErrorMessages.TitleRequired,
                                maxLength: TaskFormDto.TitleMaxLength,
                                maxLengthMessage: string.Format(ErrorMessages.TitleTooLong, nameof(TaskFormDto.Title), TaskFormDto.TitleMaxLength))
                @Html.TextAreaFieldFor(m => m.Description, rows: 7,
                                maxLength: TaskFormDto.DescriptionMaxLength,
                                maxLengthMessage: string.Format(ErrorMessages.DescriptionTooLong, nameof(TaskFormDto.Description), TaskFormDto.DescriptionMaxLength))

                <div class="kb-task-form-row">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ColumnToken, new { @class = "form-label" })
                        @await Component.InvokeAsync("Dropdown", new
                                                {
                            name = "ColumnToken",
                                                options = Model.Columns,
                                                placeholder = "-- Choose a status --",
                                                requiredMessage = ErrorMessages.ChooseStatus
                                                })
                        @Html.ValidationMessageFor(m => m.ColumnToken, null, new { @class = "text-danger" })
                    </div>

                    @Html.DateFieldFor(m => m.DueDate, min: minDate, minMessage: ErrorMessages.DueDateInPast)
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.AssigneeTokens, new { @class = "form-label", @for = "kb-assignee-field" })
                    <div class="kb-ap" data-assignee-picker>
                        <div class="form-control kb-ap-field" id="kb-assignee-field" role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="false" data-assignee-field>
                            @foreach (var user in selectedUsers)
                            {
                                <span class="kb-ap-chip" data-assignee-chip data-token="@user.Token">
                                    <span class="kb-ap-avatar" data-assignee-avatar>@Html.AvatarCircle(user.Name, noAccess: !user.HasAccess, photoUrl: user.PhotoUrl)</span>
                                    <span class="kb-ap-chip-name">@TaskCardHelpers.ShortName(user.Name)</span>
                                    @if (!user.HasAccess)
                                    {
                                        <span class="kb-noaccess-tag">No access</span>
                                    }
                                    <button type="button" class="kb-ap-chip-x" aria-label="Remove @user.Name" data-assignee-remove>×</button>
                                    <input type="hidden" name="AssigneeTokens" value="@user.Token" />
                                </span>
                            }
                            <span class="kb-ap-placeholder" data-assignee-placeholder>@(selectedUsers.Count == 0 ? "Unassigned" : "Add people…")</span>
                        </div>
                        <div class="kb-ap-menu" data-assignee-menu hidden>
                            <input type="search" class="kb-ap-search" placeholder="Search people…" aria-label="Search people" autocomplete="off" data-assignee-search />
                            <ul class="kb-ap-list" role="listbox" aria-multiselectable="true">
                                @foreach (var user in Model.Users)
                                {
                                    <li>
                                        <label class="kb-ap-option" data-assignee-option data-token="@user.Token" data-name="@user.Name" @(user.HasAccess ? "" : "data-no-access")>
                                            <input type="checkbox" class="form-check-input" checked="@user.Selected" disabled="@(!user.HasAccess && !user.Selected)" />
                                            <span class="kb-ap-avatar" data-assignee-avatar>@Html.AvatarCircle(user.Name, noAccess: !user.HasAccess, photoUrl: user.PhotoUrl)</span>
                                            <span class="kb-ap-option-name">@user.Name</span>
                                            @if (!user.HasAccess)
                                            {
                                                <span class="kb-noaccess-tag">No access</span>
                                            }
                                        </label>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                    @Html.ValidationMessageFor(m => m.AssigneeTokens, null, new { @class = "text-danger" })
                </div>

                <div>
                    @await Component.InvokeAsync("ImageGallery", new { imageUrls, removeImages = Model.RemoveImages })
                    @await Component.InvokeAsync("FileUpload", new { name = "Images", hasExisting = imageUrls.Count > 0 })
                    <span asp-validation-for="Images" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="kb-form-footer">
            @if (inModal)
            {
                <button type="button" class="kb-btn-secondary" data-bs-dismiss="modal">Cancel</button>
            }
            else
            {
                <a class="kb-btn-secondary" asp-action="Index" asp-route-boardToken="@Model.ReturnBoardToken">Cancel</a>
            }
            <button type="submit" class="kb-btn-primary">@(Model.IsNew ? "Create task" : "Save")</button>
        </div>
    </form>
</div>
